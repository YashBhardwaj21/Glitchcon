# =============================================================================
# AI MODERATION MICROSERVICE — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# One of: groq
LLM_PROVIDER=groq

# Groq API Key (default, free tier: 14,400 requests/day)
GROQ_API_KEY=your_groq_api_key_here

# Groq API Key (default, free tier: 14,400 requests/day)
GROQ_API_KEY=your_groq_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://moderator:moderator_pass@localhost:5432/moderator_db
# Used inside docker-compose (service name instead of localhost):
# DATABASE_URL=postgresql+asyncpg://moderator:moderator_pass@db:5432/moderator_db

POSTGRES_USER=moderator
POSTGRES_PASSWORD=moderator_pass
POSTGRES_DB=moderator_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Inside docker-compose:
# REDIS_URL=redis://redis:6379/0

# ─── Service Auth ─────────────────────────────────────────────────────────────
# 32-byte random secret for hashing; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_32byte_random_hex_string

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per minute per API key
DEFAULT_RATE_LIMIT_PER_MIN=60

# ─── FAISS / Embeddings ───────────────────────────────────────────────────────
# Model to use for semantic embeddings (multilingual)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# FAISS index rebuilt automatically; cached in this directory
FAISS_INDEX_DIR=./data/faiss_indices

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "json" for structured logging in production, "pretty" for dev
LOG_FORMAT=pretty

# ─── Service ──────────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Test API Keys (seed values — change in production) ───────────────────────
# These are created by the seed script and printed once. Keep them secret.
# GBA_1 app key — profile whitelist: wele_*
SEED_GBA1_API_KEY=gba1_test_key_change_in_prod
# Telegram bot key — profile whitelist: telegram_*
SEED_TELEGRAM_API_KEY=telegram_test_key_change_in_prod
