# GBA1 Consumer app configuration
APP_NAME=GBA1 Consumer Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8002
DEBUG=false

# ── Moderation Service connection ─────────────────────────────────────────────
# URL of your running AI Moderation Microservice
MODERATOR_BASE_URL=http://localhost:8001
# API key obtained from POST /v1/admin/api-keys (format: <id>.<secret>)
MODERATOR_API_KEY=your_api_key_here
MODERATOR_TIMEOUT=12.0
MODERATOR_MAX_RETRIES=3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gba1:gba1_pass@localhost:5432/gba1_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Use separate DB indices (3,4) to avoid clashing with moderator-service (1,2)
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
